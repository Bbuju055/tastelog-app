# Tastelog Environment Configuration
# Copy to .env and fill in values

# =============================================================================
# Required: Supabase
# =============================================================================
# The two keys below are syntactically valid placeholder JWTs (role claims
# "service_role" and "anon") so the test suite runs with this file copied
# verbatim. Replace them with your project's real keys to run the app.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV4YW1wbGUtcHJvamVjdCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUifQ.placeholder-signature
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV4YW1wbGUtcHJvamVjdCIsInJvbGUiOiJhbm9uIn0.placeholder-signature

# =============================================================================
# Required: Anthropic (Claude)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...your-api-key

# =============================================================================
# Required: Test user (Phase 1 MVP - single user)
# =============================================================================
TEST_USER_ID=00000000-0000-0000-0000-000000000000

# =============================================================================
# JWT Authentication (Phase 2)
# =============================================================================
# Development only: bypass JWT validation and use TEST_USER_ID
# MUST be false in production (enforced by config validator)
DEV_AUTH_BYPASS=false

# Optional JWT overrides (usually not needed - derived from SUPABASE_URL)
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# =============================================================================
# Optional: Server settings
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS origins (comma-separated, empty = locked down)
# Development: CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Production: CORS_ORIGINS=https://yourdomain.com
# CORS_ORIGINS=
