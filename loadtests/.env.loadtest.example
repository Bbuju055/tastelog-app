# Tastelog load-test harness — Phase 14.2B/C skeleton.
# Copy this file to loadtests/.env.loadtest (gitignored) and fill values
# locally. Do NOT commit real URLs, keys, project IDs, or JWTs.

# Load target — REQUIRED. Must NOT be the production host.
LOADTEST_API_BASE_URL=

# Temporary JWT consumed by the skeleton scenarios. Minted by
# loadtests/seed/run.py and written to loadtests/output/loadtest-jwt.txt
# (gitignored). Operator copies the value here or exports it directly.
LOADTEST_JWT=

# Load target Supabase — REQUIRED for seed/cleanup in 14.2C.
LOADTEST_SUPABASE_URL=
LOADTEST_SUPABASE_SERVICE_KEY=
LOADTEST_SUPABASE_ANON_KEY=

# Production project ref refusal fragment — REQUIRED for seed and
# cleanup. Operator fills this locally with a substring (or full value)
# of the PRODUCTION Supabase project ref. It is used ONLY as a refusal
# fragment by the Python guards in loadtests/lib/guards.py. Never
# logged. Scripts refuse to run if this env var is missing or empty.
LOADTEST_PROD_REF_REFUSE_FRAGMENT=

# Password used by loadtests/seed/run.py when creating seeded users.
# REQUIRED for seed. Never logged. Never committed.
LOADTEST_SEED_USER_PASSWORD=

# Seed-derived IDs consumed by Tier A k6 scenarios. Populated by the
# operator from loadtests/output/seed-ids.json after the seed run.
LOADTEST_RECIPE_ID=
LOADTEST_LIST_ID=
LOADTEST_SEARCH_QUERY=

# Optional: enable Sentry transaction tracing on the load target only.
# Production default stays 0.0 — do NOT set this on prod.
SENTRY_TRACES_SAMPLE_RATE=

# Optional: AI-stub mode for load target once 14.2D ships.
# off | deterministic
ANTHROPIC_STUB_MODE=
