{
  "cli": {
    "version": ">= 20.1.0 < 21.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "diagnostic": {
      "extends": "production",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_NAV_DIAGNOSTICS": "1"
      }
    }
  }
}
