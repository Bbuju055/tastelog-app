# Copy to .env and fill in values. All variables are public (bundled into the app).

# Required: the FastAPI backend, reachable from the device or simulator.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Required: Supabase auth. For the local stack, `make demo` at the repo root prints these.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: web app URL; enables "Open in Browser" on recipe detail.
# EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000

# Optional: exactly "true" enables streamed riff responses (anything else is off).
# EXPO_PUBLIC_RIFF_STREAMING=false

# Optional: "1" shows the navigation diagnostics UI (development only).
# EXPO_PUBLIC_NAV_DIAGNOSTICS=0

# Optional: Sentry
# EXPO_PUBLIC_SENTRY_DSN=
